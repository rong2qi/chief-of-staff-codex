{
  "schema_version": 1,
  "preset": "core",
  "scope": "global",
  "report_review_mode": "exception_only",
  "governance_model": {
    "enabled": false,
    "mode": "chair_led_cabinet",
    "operator_role": "chair",
    "general_office_title": "一人之下",
    "general_office_thread_id": null,
    "todo_title": "TODO｜待回复 Chief 汇总",
    "direct_report_policy": "chain_of_command",
    "auditor_authority": "evidence_only",
    "partial_pause_policy": "affected_surface_only",
    "continuation_policy": {
      "enabled": false,
      "default_action": "advance_best_safe_in_scope_path",
      "stop_or_defer_is_operator_initiated": true,
      "escalate_only_for": [
        "new_permission",
        "new_chief"
      ],
      "ordinary_failure_policy": "continue_bounded_diagnosis_repair_and_verification"
    }
  },
  "pin_governance": {
    "enabled": false,
    "mandatory_core_roles": [
      {"role": "general_office", "title": "General Office", "thread_id": null},
      {"role": "todo", "title": "Chief TODO", "thread_id": null},
      {"role": "creative_director", "title": "Chief of Creative Direction", "thread_id": null},
      {"role": "context_migration_monitor", "title": "Chief of Context Migration", "thread_id": null},
      {"role": "testing_director", "title": "Chief of Testing", "thread_id": null}
    ],
    "optional_chief_slots": {
      "limit": 6,
      "default_pin_primary_task": false,
      "change_mode": "recommend_then_operator_approve",
      "protect_manual_non_chief_pins": true,
      "capacity_policy": "observed_capacity_then_paired_replacement"
    },
    "recommendation_policy": {
      "owner": "general_office",
      "verifier": "todo_read_only",
      "max_candidates": 3,
      "max_pending_packs": 1,
      "criteria": ["user_delivery_value", "imminent_material_decision", "delay_cost", "cross_project_dependency", "activity", "evidence_confidence", "sidebar_cost"],
      "default_exclusions": ["paused", "completed", "superseded", "migration_cancelled", "routine_push", "meeting_summary", "report_only", "process_only"]
    },
    "successor_inheritance": {
      "enabled": true,
      "exact_list_verification_required": true,
      "pin_before_takeover": true,
      "receipt_is_not_proof": true,
      "replacement_policy": "single_same_lineage_after_safe_handoff"
    },
    "grandmothered_optional_chiefs": [],
    "protected_manual_thread_ids": [],
    "invalid_successor_thread_ids": []
  },
  "automation_inheritance": {
    "enabled": false,
    "scope": "bound_task_automations",
    "bundle_fields": ["id", "name", "kind", "target_thread_id", "status", "schedule", "prompt_sha256", "notification_policy"],
    "rebind_before": ["takeover", "authority_switch", "predecessor_archive"],
    "reuse_existing": true,
    "missing_policy": "create_one_minimal_equivalent_within_existing_authorization",
    "preserve": ["schedule", "prompt_semantics", "notification_policy", "scope"],
    "duplicate_active_same_duty": "forbidden",
    "verification": {
      "live_evidence_required": true,
      "exact_target_status_schedule_required": true,
      "reference_or_receipt_is_not_proof": true
    },
    "migration_gate": {
      "automation_parity_required": true,
      "pin_parity_when_applicable": true,
      "bundle_parity_required": true,
      "failure_status": "MIGRATION_BLOCKED",
      "failure_record": "automation_rebind_failed",
      "keep_predecessor_active_unarchived": true
    },
    "historical_repair": "remediate_without_unarchive_delete_or_duplicate"
  },
  "project_start_capability_discovery": {
    "enabled": true,
    "mode": "coverage_first",
    "timing": "before_production_execution",
    "search_surfaces": ["host_and_installed_capabilities", "codex_plugins", "codex_skills", "official_documentation", "open_source_projects", "external_configuration_patterns"],
    "evaluation_criteria": ["project_fit", "productivity_gain", "maintenance_activity", "license", "supply_chain_risk", "permission_impact", "integration_impact", "overlap"],
    "require_evidence_pack": true,
    "require_reuse_before_build": true,
    "testing_director_review": "required_for_test_capabilities",
    "acquisition_policy": "selected_fit_only_after_review",
    "cost_policy": "coverage_over_token_or_time_savings",
    "protected_actions": "separate_explicit_approval"
  },
  "visual_selection_gate": {
    "enabled": false,
    "review_hub_title": "Chief of Creative Direction｜创意总监"
  },
  "american_english_coaching": {
    "enabled": false,
    "include_casual_chat": false,
    "written": true,
    "spoken": true,
    "idiom_notes": true
  },
  "audio_playback": {
    "enabled": false,
    "clips": [
      "written",
      "spoken"
    ],
    "provider": "auto",
    "voice": null,
    "locale": "en-US",
    "rate": 175,
    "storage_root": null,
    "unavailable_behavior": "text_only"
  },
  "operator_salutation": {
    "enabled": false,
    "value": null
  },
  "paused_title_prefix": {
    "enabled": false,
    "value": "已暂停｜"
  },
  "reminders": {
    "enabled": false,
    "timezone": "Asia/Shanghai",
    "daytime_window": {
      "start": "09:00",
      "end": "18:00",
      "interval_minutes": 60,
      "include_start": true,
      "include_end": true
    },
    "additional_times": [
      "22:00"
    ]
  }
}
